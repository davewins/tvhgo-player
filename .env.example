# Copy to .env (which is git-ignored) and fill in. Never commit the real values.

# Hostname/IP of your Tvheadend server, as reachable from the tvhgo container
TVHEADEND_HOST=192.168.1.10
TVHEADEND_PORT=9981

# A dedicated, limited Tvheadend user for tvhgo (NOT the admin) - see docs/installation.md
TVHEADEND_USERNAME=tvhgo
TVHEADEND_PASSWORD=change-me

# Optional: your free TMDb v3 API key (leave empty to disable TMDb artwork) - see docs/configuration.md#tmdb-artwork
TMDB_API_KEY=
