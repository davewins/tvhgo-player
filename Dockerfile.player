# Build for the tvhgo fork with an in-browser player (live TV via mpegts.js, recordings via MP4 Range playback).
FROM node:22-alpine AS ui
WORKDIR /ui
RUN corepack enable
COPY ui/package.json ui/yarn.lock ./
RUN yarn install --non-interactive
COPY ui/ ./
RUN yarn build

FROM golang:1.26-alpine AS build
RUN apk add --no-cache build-base
ENV CGO_ENABLED=1 CGO_CFLAGS="-D_LARGEFILE64_SOURCE"
WORKDIR /build
COPY . .
COPY --from=ui /ui/dist ./ui/dist
RUN go mod download
RUN go build -o tvhgo -tags prod main.go

FROM alpine:3.22 AS prod
# ffmpeg is only used for on-demand conversion of recordings for browser playback (TVHGO_PLAYBACK_CONVERT=true)
RUN apk upgrade --no-cache && apk add --no-cache ffmpeg
COPY --from=build /build/tvhgo /bin/tvhgo
RUN adduser -D -H tvhgo
WORKDIR /tvhgo
RUN chown -R tvhgo:tvhgo /tvhgo
USER tvhgo
EXPOSE 8080
VOLUME ["/tvhgo"]
ENV TVHGO_DATABASE_PATH=/tvhgo/tvhgo.db
ENTRYPOINT ["/bin/tvhgo"]
